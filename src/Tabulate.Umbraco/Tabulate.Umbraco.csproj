<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Title>Tabulate</Title>
    <Description>Manage large datasets in Umbraco CMS.</Description>
    <PackageTags>umbraco umbraco-cms umbraco-marketplace</PackageTags>
    <StaticWebAssetBasePath>App_Plugins/Tabulate</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
  <PackageReference Include="Umbraco.Cms.Web.Website" Version="[13.*, 14)" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="ClientApp\types\" />
  </ItemGroup>

    <!-- Build client assets using NPM -->
  <Import Project="build\Microsoft.AspNetCore.ClientAssets.targets" />
  <Target Name="ClientAssetsBuildOutputPath" BeforeTargets="ClientAssetsBuild">
    <WriteLinesToFile File="ClientApp\gulp\config.outputPath.js" Lines="export const outputPath = '../$(IntermediateOutputPath.Replace('\', '/'))clientassets';" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <ItemGroup>
    <ClientAssetsInputs Remove="ClientApp\tsconfig.json" />
    <ClientAssetsInputs Remove="clientapp\types\types.d.ts" />
  </ItemGroup>
</Project>